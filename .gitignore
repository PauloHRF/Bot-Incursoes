.env
.venv/
venv/
__pycache__/
*.pyc
data/*.db
data/*.db-journal
tests/*.db
tests/*.db-journal

# As copias que tools/backup.py deixa no disco. O backup e dado do grupo, e
# o repositorio e publico: ele vai para o canal privado do Discord, nunca
# para ca.
data/backups/

# Modelos .xlsx que os geradores soltam para preencher. Descartaveis: o que
# vale e o JSON que a importacao deixa em data/incursoes e data/bancos, e uma
# planilha versionada envelhece em relacao ao JSON que ela gerou — as quatro
# que estavam aqui ficaram um mes atras dos JSON delas.
data/planilhas/

# Arquivo de trava que o Excel cria enquanto a planilha esta aberta
~$*

# Historico do aider. Fica de fora porque o repositorio e PUBLICO: transcricao
# de conversa com assistente nao tem como ser conferida antes de cada commit.
.aider*
