# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=cole_o_token_aqui

# ID do servidor de testes: faz os comandos aparecerem na hora (sem esperar ~1h)
GUILD_ID=000000000000000000

# Caminho do banco SQLite
DB_PATH=data/incursoes.db

# Intervalo minimo em dias entre incursoes do mesmo jogador
INTERVALO_DIAS=7
