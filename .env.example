# Copie para .env e preencha. O .env e ignorado pelo git: o token NUNCA
# entra no repositorio, que e publico.

# Obrigatorio: o token do bot, em Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# O id do servidor do Discord. Preenchido, os comandos aparecem na hora nele;
# vazio, a sincronizacao e global e pode levar ~1h para aparecer.
GUILD_ID=

# Onde fica o banco. Relativo a raiz do projeto, ou um caminho absoluto.
# No servidor, prefira um caminho ABSOLUTO fora do repositorio: assim nenhum
# comando do git alcanca o banco. Ex.: /var/lib/incursoes/incursoes.db
DB_PATH=data/incursoes.db

# Tamanho do grupo de uma run
TAMANHO_GRUPO=5
PONTOS_PARTICIPACAO=2

# Semanas entre incursoes do mesmo jogador (a semana vira na segunda). 0 libera geral.
INTERVALO_SEMANAS=1
# Fuso em que a segunda-feira e contada (-3 = Brasilia)
FUSO_UTC=-3
