# Copie para .env e preencha. O .env e ignorado pelo git: o token NUNCA
# entra no repositorio, que e publico.

# Obrigatorio: o token do bot, em Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# Os servidores onde os comandos de barra sao REGISTRADOS, separados por
# virgula. Preenchido, os comandos aparecem na hora em cada um; vazio, o
# registro e global — vale em todo servidor onde o bot esta, inclusive nos que
# entrarem depois, mas a primeira propagacao leva ate ~1h.
#
# Isto NAO separa os dados: o banco separa por servidor por dentro, e um bot em
# tres servidores usa um banco so.
GUILD_IDS=

# Onde fica o banco. Relativo a raiz do projeto, ou um caminho absoluto.
# No servidor, prefira um caminho ABSOLUTO fora do repositorio: assim nenhum
# comando do git alcanca o banco. Ex.: /var/lib/incursoes/incursoes.db
DB_PATH=data/incursoes.db

# Tamanho do grupo de uma run
TAMANHO_GRUPO=5
PONTOS_PARTICIPACAO=2

# Semanas entre incursoes do mesmo jogador (a semana vira na segunda). 0 libera geral.
INTERVALO_SEMANAS=1
# Fuso em que a segunda-feira e contada (-3 = Brasilia)
FUSO_UTC=-3

# Para onde o tools/backup.py manda a copia do banco: um webhook de um canal
# PRIVADO. Quem ve o canal baixa o banco inteiro. Vazio, o backup so guarda a
# copia local e avisa — nao e erro.
BACKUP_WEBHOOK=

# So preencha se o bot estiver em mais de um servidor: o arquivo ENVIADO passa
# a levar so os dados desta guilda, para o canal de um servidor nao receber as
# fichas de outro. A copia local continua inteira, que e o que restaura tudo.
# Um valor que nao seja um id PARA o backup, em vez de mandar o banco todo.
BACKUP_GUILDA=
