[Unit]
Description=Backup diario do banco do Bot de Incursoes

[Timer]
# Todo dia as 4h da manha NO FUSO DO GRUPO, e nao no da maquina. Diario e nao
# semanal porque o arquivo tem 35 KB comprimido: o custo de guardar e nenhum,
# e a perda de um dia de jogo doi muito mais que a de 14 arquivos no disco.
#
# O fuso vem escrito porque a maquina da Oracle roda em UTC: sem ele, as "4h"
# disparavam as 01:0x do horario de quem joga — e o arquivo saia com 01:0x no
# nome, porque o nome usa o FUSO do projeto (`config.FUSO`, UTC-3). Quem
# procurasse "o backup das 4h" acharia um de uma da manha.
#
# Esta escrito em UTC, e nao como `04:00:00 America/Sao_Paulo`, porque o
# sufixo de fuso no OnCalendar so existe do systemd 252 em diante e o leeroy
# roda o 249 (Ubuntu 22.04). Nele, a linha com o nome do fuso faz a unidade
# falhar a carregar — nao e questao de gosto.
#
# 07:00 UTC e 04:00 em Sao Paulo, e segue sendo enquanto o Brasil nao voltar
# com horario de verao (abolido em 2019). Se voltar, ou se a maquina subir
# para systemd >= 252, troque por:
#   OnCalendar=*-*-* 04:00:00 America/Sao_Paulo
OnCalendar=*-*-* 07:00:00 UTC
# Se a maquina estava desligada na hora, roda ao voltar — Always Free da
# Oracle reinicia instancia sem avisar.
Persistent=true
# Espalha o disparo em ate 10 min: nada corre junto do restart do bot.
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
